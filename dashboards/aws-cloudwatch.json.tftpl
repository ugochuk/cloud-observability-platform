{
  "widgets": [
    {
      "type": "metric",
      "x": 0,
      "y": 0,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Checkout API Errors and Latency",
        "region": "${aws_region}",
        "view": "timeSeries",
        "metrics": [
          ["CloudObservabilityPortfolio", "5XXError", "Cluster", "${cluster}", "Service", "checkout-api", {"stat": "Sum"}],
          [".", "LatencyP95", ".", ".", ".", ".", {"stat": "Average", "yAxis": "right"}]
        ],
        "period": 300
      }
    },
    {
      "type": "log",
      "x": 12,
      "y": 0,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Recent Application Errors",
        "region": "${aws_region}",
        "query": "SOURCE '${log_group}' | fields @timestamp, level, trace_id, message | filter level in ['ERROR', 'FATAL'] | sort @timestamp desc | limit 50",
        "view": "table"
      }
    }
  ]
}
